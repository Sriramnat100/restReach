# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Never commit real keys or secrets.
#
# Nothing reads these yet. They are wired up in Milestones 1-2 (see docs/ROADMAP.md).

# --- Supabase -----------------------------------------------------------------
# Find these in the Supabase dashboard: Project Settings -> API Keys, or the
# project's "Connect" dialog. For the local stack (`npx supabase start`), the CLI
# prints local values.
#
# Use the new publishable/secret keys. The legacy `anon` / `service_role` keys
# stop working at the end of 2026.

# Project URL. Public: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable key (sb_publishable_...). Public: safe to expose to the browser.
# Every request made with it is still restricted by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Secret key (sb_secret_...). SERVER-ONLY. It BYPASSES Row Level Security.
# Never prefix it with NEXT_PUBLIC_ and never import it from client code.
# Only used for admin-only operations such as inviting restaurant owners.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# --- App ----------------------------------------------------------------------
# Absolute base URL of this app. Used to build auth redirect links (invites,
# password resets) so they never depend on the request's Host header.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
